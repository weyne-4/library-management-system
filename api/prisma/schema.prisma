generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  role      Role     @default(PATRON)
  createdAt DateTime @default(now())
}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[]
}

model Book {
  id        Int      @id @default(autoincrement())
  title     String
  author    String
  available Boolean  @default(true)
  genreId   Int
  genre     Genre    @relation(fields: [genreId], references: [id])
  createdAt DateTime @default(now())
}
